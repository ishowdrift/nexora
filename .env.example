# ==============================================================================
# NEXORA MULTI-TENANT B2B SAAS - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Credentials (from your Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Key (SERVER-ONLY, NEVER exposed to browser)
# Used exclusively in secure server-side webhook endpoints / admin initialization
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo Mode Toggle:
# Set to 'true' to run with the high-fidelity in-memory/deterministic mock database
# for instant evaluation with pre-seeded users and organizations.
# Set to 'false' to require live Supabase PostgreSQL connection with RLS.
NEXT_PUBLIC_DEMO_MODE=true
